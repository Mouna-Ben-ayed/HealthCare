<!-- res/drawable/edittext_background.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- État lorsque le champ est activé (focus) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/bleu" /> <!-- Utilise votre couleur @color/bleu -->
        </shape>
    </item>

    <!-- État par défaut (non focus) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F0F4F7" /> <!-- Un fond gris très clair -->
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#D0D0D0" /> <!-- Bordure grise claire -->
        </shape>
    </item>

</selector>
